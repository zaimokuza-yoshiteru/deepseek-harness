{
  "name": "dsh-atlassian-kanban",
  "version": "0.1.0-alpha.10",
  "private": true,
  "description": "Read-first Jira, Bitbucket and Confluence integration for DeepSeek Harness.",
  "icon": "./assets/icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.1.7-rc.2 || 0.2.0-rc.2"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "gen": "node scripts/gen-typert.mjs",
    "typecheck": "pnpm gen && tsc --noEmit",
    "build": "node scripts/clean.mjs && pnpm gen && tsc && tsdown",
    "test": "vitest run --config test/vitest.config.ts --maxWorkers=2",
    "test:integration": "vitest run --config test/vitest.integration.config.ts --maxWorkers=2",
    "prepack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hmr": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2 || 0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
